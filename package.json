{
  "name": "kiwi-events",
  "version": "1.0.0",
  "license": "SEE LICENSE IN LICENSE",
  "description": "Generic headless event and ticketing backend with pluggable database, storage, and payment providers",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "dev:staging": "dotenv -e .env.staging -- nodemon src/server.js",
    "start": "node src/server.js",
    "db:migrate": "node src/scripts/migrate.js",
    "db:migrate:staging": "dotenv -e .env.staging -- node src/scripts/migrate.js",
    "db:rollback": "node src/scripts/rollback.js",
    "db:rollback:staging": "dotenv -e .env.staging -- node src/scripts/rollback.js",
    "reset": "node src/scripts/reset-kiwi-events.js",
    "reset:yes": "node src/scripts/reset-kiwi-events.js --yes",
    "format": "prettier \"src/**/*.js\" --write",
    "format:check": "prettier \"src/**/*.js\" --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "release:package": "node scripts/build-release.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.860.0",
    "@mollie/api-client": "^4.5.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.2.10",
    "mongoose": "^8.18.0",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "mysql2": "^3.22.4",
    "nodemailer": "^9.0.1",
    "pdfkit": "^0.18.0",
    "pg": "^8.21.0",
    "qrcode": "^1.5.4",
    "sanitize-html": "^2.17.7",
    "stripe": "^22.1.1",
    "uuid": "^11.1.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.8",
    "dotenv-cli": "^11.0.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.8.4",
    "supertest": "^7.2.2",
    "vitest": "^4.1.8"
  }
}
